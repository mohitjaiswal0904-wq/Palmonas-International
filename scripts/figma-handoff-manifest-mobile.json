  "flows": [
    {
      "id": "discovery",
      "title": "Flow 1 — Discovery & Browse",
      "summary": "User lands on homepage, explores categories/collections, and reaches a product listing.",
      "entryPoints": [
        "Direct URL",
        "Header nav",
        "Footer links",
        "Homepage CTAs"
      ],
      "steps": [
        {
          "order": 1,
          "frame": "Mobile // Home / Default",
          "route": "/",
          "code": "src/app/page.tsx",
          "behavior": "Hero + category grid + collection editorial. Data from @/data (categories, products, BANNERS)."
        },
        {
          "order": 2,
          "frame": "Mobile // Jewellery / All",
          "route": "/jewellery",
          "code": "src/app/jewellery/page.tsx",
          "behavior": "Full catalogue PLP with sort/filter query params (?sort=new, ?metal=silver)."
        },
        {
          "order": 3,
          "frame": "Mobile // Jewellery / Rings",
          "route": "/jewellery/rings",
          "code": "src/app/jewellery/[category]/page.tsx",
          "behavior": "Category PLP. Filters open via ui store overlay=filters."
        },
        {
          "order": 4,
          "frame": "Mobile // Collections / Index",
          "route": "/collections",
          "code": "src/app/collections/page.tsx",
          "behavior": "Only collections with products appear (enriched productIds)."
        }
      ],
      "state": [
        "region store → currency display via useRegionalMoney",
        "ui store → search/cart/wishlist overlays"
      ],
      "edgeCases": [
        "Empty collection shells hidden from index",
        "PLP filters persist in URL query string"
      ]
    },
    {
      "id": "pdp-cart",
      "title": "Flow 2 — Product Detail → Cart",
      "summary": "User views a product, selects metal/stone/size, adds to bag, opens cart drawer.",
      "entryPoints": [
        "PLP product card",
        "Homepage rails",
        "Collection detail grids"
      ],
      "steps": [
        {
          "order": 1,
          "frame": "Mobile // PDP / Default",
          "route": "/jewellery/[category]/[slug]",
          "code": "src/app/jewellery/[category]/[slug]/page.tsx",
          "behavior": "Gallery + ProductBuyPanel. Variant selection (metal, stone, size) before add."
        },
        {
          "order": 2,
          "frame": "Mobile // Overlay / Cart Drawer",
          "route": "(overlay)",
          "code": "src/components/commerce/CartDrawer.tsx",
          "behavior": "Opens when ui.overlay=cart. Lines from cart store (persisted palmonas-cart)."
        }
      ],
      "state": [
        "cart store: add/remove/setQuantity/toggleGiftWrap",
        "Cart line key = productId + metal + stone + size"
      ],
      "edgeCases": [
        "Gift wrap adds $15 per line",
        "Checkout blocked if cart empty"
      ]
    },
    {
      "id": "checkout",
      "title": "Flow 3 — Checkout (4 steps)",
      "summary": "Signed-out purchase path from cart through address, offers, review, confirmation.",
      "entryPoints": [
        "Cart drawer → Checkout CTA"
      ],
      "steps": [
        {
          "order": 1,
          "frame": "Mobile // Checkout / Step 1 Address",
          "route": "/checkout/address",
          "code": "src/app/checkout/address/page.tsx",
          "behavior": "Select saved address or add new. Redirects to /jewellery if cart empty."
        },
        {
          "order": 2,
          "frame": "Mobile // Checkout / Step 2 Offers",
          "route": "/checkout/coupon",
          "code": "src/app/checkout/coupon/page.tsx",
          "behavior": "Apply coupon codes from src/data/commerce/coupons.ts."
        },
        {
          "order": 3,
          "frame": "Mobile // Checkout / Step 3 Review",
          "route": "/checkout/review",
          "code": "src/app/checkout/review/page.tsx",
          "behavior": "Order summary. Totals via computeCheckoutTotals (8% tax, complimentary shipping)."
        },
        {
          "order": 4,
          "frame": "Mobile // Checkout / Confirmation",
          "route": "/checkout/confirmation",
          "code": "src/app/checkout/confirmation/page.tsx",
          "behavior": "Success state. Cart cleared on place order."
        }
      ],
      "state": [
        "CheckoutShell guards empty cart",
        "CheckoutUiContext shares step state client-side",
        "Dev capture: ?figmaSeed=cart auto-seeds cart"
      ],
      "edgeCases": [
        "/checkout redirects to address",
        "No real payment API — prototype only"
      ]
    },
    {
      "id": "account",
      "title": "Flow 4 — Account & Orders",
      "summary": "Sign in, manage profile, view orders and saved addresses.",
      "entryPoints": [
        "Header user icon",
        "/account direct URL"
      ],
      "steps": [
        {
          "order": 1,
          "frame": "Mobile // Account / Sign In",
          "route": "/account",
          "code": "src/app/account/page.tsx",
          "behavior": "Sign in / register forms. Demo: meera@palmonas.com / palmonas."
        },
        {
          "order": 2,
          "frame": "Mobile // Account / Profile",
          "route": "/account/profile",
          "code": "src/app/account/profile/page.tsx",
          "behavior": "Edit name/phone. Requires authenticated user."
        },
        {
          "order": 3,
          "frame": "Mobile // Account / Orders",
          "route": "/account/orders",
          "code": "src/app/account/orders/page.tsx",
          "behavior": "Lists demoOrders from @/data."
        },
        {
          "order": 4,
          "frame": "Mobile // Account / Order Detail",
          "route": "/account/orders/[id]",
          "code": "src/app/account/orders/[id]/page.tsx",
          "behavior": "Timeline + line items for single order."
        },
        {
          "order": 5,
          "frame": "Mobile // Account / Addresses",
          "route": "/account/addresses",
          "code": "src/app/account/addresses/page.tsx",
          "behavior": "Saved addresses CRUD (client-only)."
        }
      ],
      "state": [
        "account store persisted as palmonas-account",
        "AccountDrawer mirrors sign-in UX"
      ],
      "edgeCases": [
        "Unauthenticated users redirected to /account",
        "Dev capture: ?figmaSeed=account auto-signs demo user"
      ]
    },
    {
      "id": "content",
      "title": "Flow 5 — Content & Support",
      "summary": "Static info pages, policies, contact, stores.",
      "entryPoints": [
        "Footer",
        "Header secondary nav"
      ],
      "steps": [
        {
          "order": 1,
          "frame": "Mobile // About / Default",
          "route": "/about",
          "code": "src/data/content/info/about.ts"
        },
        {
          "order": 2,
          "frame": "Mobile // Contact / Default",
          "route": "/contact",
          "code": "src/data/content/info/contact.ts"
        },
        {
          "order": 3,
          "frame": "Mobile // Stores / Default",
          "route": "/stores",
          "code": "src/data/commerce/stores.ts"
        },
        {
          "order": 4,
          "frame": "Mobile // Policies / Index",
          "route": "/policies",
          "code": "src/app/policies/page.tsx"
        },
        {
          "order": 5,
          "frame": "Mobile // Policies / Shipping",
          "route": "/policies/shipping-delivery",
          "code": "src/app/policies/[slug]/page.tsx"
        }
      ],
      "state": [
        "All copy authored in src/data/content/info/"
      ],
      "edgeCases": [
        "Blogs page is a stub"
      ]
    },
    {
      "id": "overlays",
      "title": "Flow 6 — Global Overlays",
      "summary": "Chrome-level UI not tied to a single route. Controlled by ui store.",
      "entryPoints": [
        "Header icons",
        "Mobile nav trigger"
      ],
      "steps": [
        {
          "order": 1,
          "frame": "Mobile // Overlay / Search",
          "route": "(overlay)",
          "code": "src/components/navigation/SearchOverlay.tsx",
          "behavior": "ui.overlay=search. Client-side product search."
        },
        {
          "order": 2,
          "frame": "Mobile / Overlay / Nav Menu",
          "route": "(overlay)",
          "code": "src/components/layout/MobileNav.tsx",
          "behavior": "ui.overlay=menu. Left drawer nav."
        },
        {
          "order": 3,
          "frame": "Mobile // Overlay / Wishlist",
          "route": "(overlay)",
          "code": "src/components/commerce/WishlistDrawer.tsx",
          "behavior": "ui.overlay=wishlist. IDs in wishlist store."
        },
        {
          "order": 4,
          "frame": "Mobile // Overlay / Account Drawer",
          "route": "(overlay)",
          "code": "src/components/account/AccountDrawer.tsx",
          "behavior": "Quick sign-in without leaving page."
        }
      ],
      "state": [
        "Only one overlay active at a time (ui.overlay enum)"
      ],
      "edgeCases": [
        "Opening overlay closes others via ui.open()"
      ]
    }
  ],
